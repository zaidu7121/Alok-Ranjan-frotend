"use client";
import Image from "next/image";
import Link from "next/link";
import { motion, useReducedMotion } from "framer-motion";
import { ArrowRight,Scale,Search,FileText,PenTool,Network,UserRound,BrainCircuit,Handshake } from "lucide-react";
import { Swiper,SwiperSlide } from "swiper/react";
import { A11y,Keyboard } from "swiper/modules";
import "swiper/css";
import type { SiteSettings,Expertise,Work,Publication,NewsItem } from "@/types";
import { ArticleCard,ExpertiseTile,SectionTitle,ViewMore,WorkCard } from "@/components/ui";
const heroIcons=[Scale,Search,FileText,PenTool,Network,UserRound,BrainCircuit,Handshake];
export function Hero({settings,expertise}:{settings:SiteSettings;expertise:Expertise[]}) {
 const reduce=useReducedMotion();
 return <section className="hero"><div className="hero-image"><Image src={settings.heroImage.url} alt={settings.heroImage.alt} fill priority sizes="100vw" className="object-cover"/></div><div className="hero-shade"/><div className="hero-content mx-auto max-w-content px-5 lg:px-8"><motion.div initial={reduce?false:{opacity:0,y:20}} animate={{opacity:1,y:0}} transition={{duration:.7}}><p className="eyebrow text-white/75">{settings.heroSubtitle}</p><h1 className="hero-title">{settings.heroTitle}</h1><p className="mt-5 max-w-xl text-lg leading-relaxed text-white/80">{settings.intro}</p><Link href="/about" className="hero-link mt-8">Explore my practice <ArrowRight size={17}/></Link></motion.div></div>
 <div className="hero-tiles mx-auto grid max-w-content grid-cols-4 gap-2 px-5 md:grid-cols-8 lg:px-8">{heroIcons.map((Icon,i)=><Link key={i} href="/expertise" className="hero-tile"><Icon size={22} strokeWidth={1.5}/><span>{expertise[i]?.title.split(" ").slice(0,2).join(" ")||"IP Law"}</span></Link>)}</div>
 <div className="intro-overlap mx-auto max-w-content px-5 lg:px-8"><div className="intro-card"><p className="eyebrow">A PRACTICE BUILT ON RESEARCH</p><p className="font-serif text-2xl leading-relaxed text-navy md:text-3xl">Clear thinking. Careful research. Practical intellectual property support.</p><ViewMore href="/about"/></div></div></section>;
}
export function AboutSection({settings}:{settings:SiteSettings}) {
 return <section className="section-pad"><div className="mx-auto grid max-w-content gap-12 px-5 md:grid-cols-[.85fr_1.15fr] md:items-center lg:px-8"><div className="portrait-frame"><Image src={settings.portrait.url} alt={settings.portrait.alt} fill sizes="(max-width:768px) 100vw, 40vw" className="object-cover"/></div><div><SectionTitle eyebrow="ABOUT ME" title="A considered approach to IP law"/><p className="mt-8 text-muted leading-8">I am an early-career intellectual property lawyer based in India. My work and research focus on the legal and commercial questions that arise around brands, inventions, creative works and emerging technologies.</p><p className="mt-4 text-muted leading-8">My academic training and internship experience have included trademark prosecution, search analysis and research across evolving areas of intellectual property law.</p><div className="credential-grid mt-8"><div><strong>B.A. LL.B.</strong><span>New Law College, Pune</span></div><div><strong>Rank 9 / 171</strong><span>CGPA 8.3</span></div><div><strong>AIBE qualified</strong><span>Diploma in Intellectual Property Rights</span></div></div><div className="mt-8 flex flex-wrap items-center gap-5"><a href={settings.profilePdf} className="button-primary" target="_blank" rel="noreferrer">Download Profile <ArrowRight size={16}/></a><ViewMore href="/about"/></div></div></div></section>;
}
export function ExpertiseSection({items}:{items:Expertise[]}) { return <section className="section-pad bg-cream"><div className="mx-auto max-w-content px-5 lg:px-8"><SectionTitle eyebrow="EXPERTISE" title="Areas of focus" description="Research and practical support across established IP rights and developing areas of law."/><div className="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{items.map(item=><ExpertiseTile key={item._id} item={item}/>)}</div><div className="mt-9 text-center"><ViewMore href="/expertise"/></div></div></section>; }
export function WorkSection({items}:{items:Work[]}) { return <section className="section-pad"><div className="mx-auto max-w-content px-5 lg:px-8"><SectionTitle eyebrow="MY WORK" title="Selected work and research" description="Anonymised examples of research and support. Each item is presented as a representative matter."/><div className="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{items.slice(0,3).map(item=><WorkCard key={item._id} item={item}/>)}</div><div className="mt-9 text-center"><ViewMore href="/work"/></div></div></section>; }
function CarouselSection({title,eyebrow,items,href}:{title:string;eyebrow:string;items:(Publication|NewsItem)[];href:string}) {
 return <section className="section-pad bg-cream"><div className="mx-auto max-w-content px-5 lg:px-8"><SectionTitle eyebrow={eyebrow} title={title}/><div className="mt-12"><Swiper modules={[A11y,Keyboard]} keyboard={{enabled:true}} a11y={{prevSlideMessage:"Previous item",nextSlideMessage:"Next item"}} spaceBetween={24} slidesPerView={1.05} breakpoints={{640:{slidesPerView:2},1024:{slidesPerView:3}}}>{items.slice(0,6).map(item=><SwiperSlide key={item._id}><ArticleCard item={item}/></SwiperSlide>)}</Swiper></div><div className="mt-9 text-center"><ViewMore href={href}/></div></div></section>;
}
export function PublicationsSection({items}:{items:Publication[]}) { return <CarouselSection title="Ideas, analysis and publications" eyebrow="KNOWLEDGE" items={items} href="/publications"/>; }
export function NewsSection({items}:{items:NewsItem[]}) { return <CarouselSection title="Updates and appearances" eyebrow="NEWS AND MEDIA" items={items} href="/news"/>; }
