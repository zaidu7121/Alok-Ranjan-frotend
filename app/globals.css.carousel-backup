@tailwind base;
@tailwind components;
@tailwind utilities;
:root{color-scheme:light;--navy:#3B4A6B;--navy-deep:#26334F;--navy-soft:#596987;--cream:#F7EDE3;--ink:#1F2937}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);font-family:var(--font-inter),sans-serif;font-size:15px;line-height:1.65}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #B58A61;outline-offset:3px}.skip-link{position:absolute;left:12px;top:-60px;z-index:1000;background:#fff;padding:12px 16px}.skip-link:focus{top:12px}.text-muted{color:#5E6673}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.2em;color:var(--navy-soft);text-transform:uppercase}.heading-xl,.heading-lg{font-family:var(--font-playfair),serif;color:var(--navy);font-weight:500;line-height:1.12}.heading-xl{font-size:clamp(2.6rem,5vw,4.6rem)}.heading-lg{font-size:clamp(2rem,3vw,3rem)}.section-pad{padding:104px 0}.section-title{display:flex;align-items:center;justify-content:center;gap:26px}.section-rule{height:1px;background:#C8BFB5;flex:1;max-width:150px}.view-more,.inline-link{display:inline-flex;align-items:center;gap:10px;color:var(--navy);font-size:13px;font-weight:700;letter-spacing:.04em}.view-more svg,.inline-link svg{transition:transform .2s}.view-more:hover svg,.inline-link:hover svg{transform:translateX(4px)}.site-header{position:fixed;inset:0 0 auto;z-index:50;background:transparent;color:white;transition:background .25s,box-shadow .25s,color .25s}.site-header.is-scrolled{background:white;color:var(--navy);box-shadow:0 5px 24px rgba(31,41,55,.08)}.brand{display:inline-flex;align-items:center;gap:11px}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid currentColor;font-family:var(--font-playfair),serif;font-size:19px}.brand-name{font-family:var(--font-playfair),serif;font-size:17px;line-height:1.1}.brand-name small{display:block;margin-top:5px;font-family:var(--font-inter),sans-serif;font-size:8px;letter-spacing:.14em}.nav-link{font-size:12px;font-weight:600;letter-spacing:.02em;opacity:.9}.nav-link:hover{opacity:1}.menu-toggle{padding:8px}.mobile-nav{background:white;color:var(--navy);padding:8px 24px 22px;box-shadow:0 12px 20px #0001}.mobile-nav a{display:block;padding:12px 0;border-bottom:1px solid #eee}.hero{position:relative;min-height:760px;padding-top:150px;background:var(--navy-deep);color:white}.hero-image,.hero-shade{position:absolute;inset:0}.hero-image img{object-position:center 42%}.hero-shade{background:linear-gradient(90deg,rgba(22,32,52,.88),rgba(22,32,52,.58) 55%,rgba(22,32,52,.22))}.hero-content{position:relative;z-index:1;padding-top:75px;padding-bottom:85px}.hero-title{max-width:740px;margin-top:18px;font-family:var(--font-playfair),serif;font-size:clamp(3rem,6.6vw,6rem);font-weight:500;line-height:1.02}.hero-link{display:inline-flex;align-items:center;gap:12px;border-bottom:1px solid #ffffff80;padding-bottom:8px;font-size:13px;font-weight:600}.hero-tiles{position:relative;z-index:2}.hero-tile{display:flex;min-height:95px;flex-direction:column;align-items:center;justify-content:center;gap:8px;border:1px solid #ffffff35;background:#26334fd9;color:white;text-align:center;font-size:10px;transition:background .2s}.hero-tile:hover{background:#3B4A6B}.intro-overlap{position:relative;z-index:3;margin-top:-1px}.intro-card{position:relative;top:44px;display:flex;align-items:center;justify-content:space-between;gap:30px;background:white;padding:34px 42px;box-shadow:0 15px 45px #1f29371a}.intro-card .eyebrow{margin-bottom:10px}.intro-card>div{flex-shrink:0}.portrait-frame{position:relative;min-height:510px;background:var(--cream)}.credential-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;border-top:1px solid #ddd5ce;border-bottom:1px solid #ddd5ce;padding:18px 0}.credential-grid div{display:flex;flex-direction:column;gap:5px}.credential-grid strong{font-family:var(--font-playfair),serif;color:var(--navy);font-size:17px;font-weight:500}.credential-grid span{font-size:11px;color:#667080}.button-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:1px solid var(--navy);background:var(--navy);padding:13px 20px;color:white;font-size:12px;font-weight:700;transition:transform .2s,background .2s}.button-primary:hover{transform:translateY(-2px);background:var(--navy-deep)}.button-primary:disabled{opacity:.65;cursor:wait}.expertise-tile{position:relative;display:flex;min-height:170px;flex-direction:column;align-items:flex-start;justify-content:space-between;border:1px solid #e6dcd2;background:#fff;padding:24px;box-shadow:0 8px 24px #1f29370a;transition:transform .2s,box-shadow .2s}.expertise-tile:hover{transform:translateY(-3px);box-shadow:0 12px 30px #1f293714}.icon-wrap{display:grid;place-items:center;width:42px;height:42px;background:var(--cream);color:var(--navy)}.tile-arrow{position:absolute;right:24px;bottom:26px;color:var(--navy-soft)}.work-card{display:block;overflow:hidden;background:var(--navy)}.work-caption{min-height:112px;padding:20px 22px;background:var(--navy)}.article-card{height:100%;background:white;box-shadow:0 10px 30px #1f293710}.article-card .eyebrow{font-size:9px}.page-intro{background:var(--cream);padding:175px max(24px,calc((100vw - 1200px)/2)) 76px}.page-intro .heading-xl{max-width:900px;margin-top:15px}.content-wrap{max-width:1200px;margin:0 auto;padding:72px 24px 100px}.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:70px}.detail-image{position:relative;aspect-ratio:16/9;background:var(--cream)}.detail-copy{font-size:17px;line-height:1.9;color:#505a68}.detail-copy p+p{margin-top:20px}.detail-aside{background:var(--cream);padding:28px;height:max-content}.detail-aside h2{font-family:var(--font-playfair),serif;color:var(--navy);font-size:22px}.site-footer{background:var(--navy-deep);color:white}.brand-footer{color:white}.footer-heading{margin-bottom:19px;font-family:var(--font-playfair),serif;font-size:21px;font-weight:500}.footer-list{display:grid;gap:11px;color:#ffffffa8;font-size:12px}.footer-list a:hover,.footer-bottom a:hover{color:white}.footer-list a{display:inline-flex;align-items:center;gap:5px}.contact-form{display:grid;gap:22px}.form-field{display:grid;gap:8px;font-size:12px;font-weight:700;color:var(--navy)}.form-field input,.form-field textarea{width:100%;border:1px solid #d8d2cc;background:#fff;padding:13px 14px;color:var(--ink);font-size:14px;font-weight:400}.form-field small,.form-error{color:#a12f2f;font-size:12px}.form-success{color:#276749;font-size:13px}.contact-form .button-primary{justify-self:start}.filter-bar{display:flex;flex-wrap:wrap;gap:12px}.filter-bar input,.filter-bar select{border:1px solid #d8d2cc;background:white;padding:11px 13px}.pagination{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:45px}.pagination button{border:1px solid #d8d2cc;padding:8px 13px;color:var(--navy)}.pagination button:disabled{opacity:.35}.not-found{min-height:55vh;display:grid;place-items:center;text-align:center;padding:80px 24px}
@media(max-width:767px){.section-pad{padding:72px 0}.hero{min-height:760px;padding-top:100px}.hero-content{padding-top:95px;padding-bottom:55px}.hero-tiles{padding-bottom:0}.hero-tile{min-height:76px;font-size:9px}.intro-card{top:28px;display:block;padding:25px}.intro-card .view-more{margin-top:20px}.portrait-frame{min-height:380px}.credential-grid{grid-template-columns:1fr;gap:12px}.section-title{gap:12px}.section-rule{max-width:35px}.page-intro{padding-top:135px;padding-bottom:55px}.content-wrap{padding:48px 20px 72px}.detail-layout{grid-template-columns:1fr;gap:35px}.footer-bottom{align-items:flex-start}.brand-name{font-size:15px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
